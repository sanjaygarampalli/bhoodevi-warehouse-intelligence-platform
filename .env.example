APP_NAME=BHOODEVI Warehouse Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql://username:password@localhost:5432/bwip_db
OPENAI_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SECRET_KEY=
GOOGLE_CLIENT_ID=

# Optional Google Identity Services OAuth 2.0 Web client ID for the deployed
# frontend origin — leave empty to keep Google sign-in disabled. Example
# placeholder: GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# For staging/production set APP_ENV appropriately, DEBUG=False, and use a
# randomly generated SECRET_KEY with at least 32 characters. Do not commit
# real credentials. Use a PostgreSQL DATABASE_URL outside local development.
